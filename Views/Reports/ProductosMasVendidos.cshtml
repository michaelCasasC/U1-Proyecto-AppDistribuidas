@model ProductosMasVendidosViewModel

@{
    ViewData["Title"] = "Productos Más Vendidos";
}

<style>
    :root{
        --tinta:#241F1B;
        --crema:#FBF4E8;
        --crema-2:#F1E6D2;
        --terracota:#C75D3D;
        --terracota-d:#9C3F26;
        --mostaza:#E0A845;
        --salvia:#6B7A4F;
        --linea:#E2D3B4;
    }
    .em-rep-page{ font-family:'Work Sans','Segoe UI',sans-serif; color:var(--tinta); }
    .em-rep-header{
        display:flex; justify-content:space-between; align-items:center;
        margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;
    }
    .em-rep-header h1{
        font-family:'Fraunces', Georgia, serif; font-weight:600; font-size:1.8rem;
        color:var(--tinta); margin:0; display:flex; align-items:center; gap:.6rem;
    }
    .em-rep-header h1::before{
        content:""; display:inline-block; width:10px; height:10px;
        border-radius:50%; background:var(--terracota);
    }
    .em-btn-sec{
        background:transparent; border:1.5px solid var(--linea); color:var(--tinta);
        border-radius:999px; font-weight:600; font-size:.85rem; padding:.55rem 1.2rem;
        cursor:pointer; transition:background .18s ease; text-decoration:none; display:inline-block;
    }
    .em-btn-sec:hover{ background:var(--crema-2); }
    .em-table-wrap{
        background:#fff; border:1px solid var(--linea); border-radius:16px; overflow:auto;
    }
    .em-table{
        width:100%; border-collapse:collapse; min-width:700px;
    }
    .em-table thead th{
        background:var(--tinta); color:var(--crema); font-size:.72rem;
        font-weight:700; letter-spacing:.07em; text-transform:uppercase;
        padding:.95rem 1rem; text-align:left; white-space:nowrap;
    }
    .em-table tbody td{
        padding:.85rem 1rem; border-bottom:1px solid var(--linea);
        font-size:.9rem; color:var(--tinta);
    }
    .em-table tbody tr:last-child td{ border-bottom:none; }
    .em-table tbody tr:hover{ background:var(--crema-2); }
    .chart-wrap{ background:#fff; border:1px solid var(--linea); border-radius:16px; padding:1.5rem; margin-bottom:1.5rem; }
</style>

<div class="em-rep-page">

    <div class="em-rep-header">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="Index" class="em-btn-sec">← Volver</a>
    </div>

    @if (Model.Items.Any())
    {
        <div class="chart-wrap">
            <canvas id="productosChart" height="120"></canvas>
        </div>

        <div class="em-table-wrap">
            <table class="em-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Emprendimiento</th>
                        <th>Unidades Vendidas</th>
                        <th>Total Generado</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@i</td>
                            <td><strong>@item.Producto</strong></td>
                            <td>@item.Categoria</td>
                            <td>@item.Emprendimiento</td>
                            <td>@item.CantidadVendida</td>
                            <td>$@item.TotalGenerado.ToString("N2")</td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            const ctx = document.getElementById('productosChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: [@Html.Raw(string.Join(",", Model.Items.Take(10).Select(i => $"'{i.Producto}'")))],
                    datasets: [{
                        label: 'Unidades Vendidas',
                        data: [@string.Join(",", Model.Items.Take(10).Select(i => i.CantidadVendida.ToString()))],
                        backgroundColor: '#6B7A4F',
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    indexAxis: 'y',
                    plugins: { legend: { display: false } },
                    scales: { x: { beginAtZero: true } }
                }
            });
        </script>
    }
    else
    {
        <p style="color:#7a7164;padding:2rem 0;">Sin datos disponibles.</p>
    }

</div>

@model Proyecto.Models.Pedido

@{
    ViewData["Title"] = "Seleccionar Método de Pago";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-credit-card me-2"></i> Seleccionar Método de Pago</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info mb-4">
                        <i class="bi bi-info-circle me-2"></i>
                        Pedido <strong>#@Model.Id</strong> - Total: <strong class="text-success fs-5">$@Model.Total.ToString("F2") USD</strong>
                    </div>

                    <h5 class="mb-3">Detalle del Pedido</h5>
                    <div class="table-responsive mb-4">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-center">Cant.</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Detalles)
                                {
                                    <tr>
                                        <td>@item.Producto?.Nombre</td>
                                        <td class="text-end">$@item.PrecioUnitario.ToString("F2")</td>
                                        <td class="text-center">@item.Cantidad</td>
                                        <td class="text-end fw-bold">$@item.Total.ToString("F2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-active">
                                    <th colspan="3" class="text-end">Total</th>
                                    <th class="text-end text-success fs-5">$@Model.Total.ToString("F2")</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <hr class="my-4" />

                    <h5 class="mb-3">Elige cómo pagar</h5>

                    <div class="row g-3">
                        <!-- PayPal -->
                        <div class="col-12 col-md-6">
                            <form asp-action="PayPalCreate" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="pedidoId" value="@Model.Id" />
                                <button type="submit" class="btn btn-outline-primary w-100 p-4 h-100 d-flex flex-column align-items-center justify-content-center" style="min-height: 160px;">
                                    <i class="bi bi-paypal fs-1 text-primary mb-2"></i>
                                    <span class="fw-semibold fs-5">PayPal</span>
                                    <small class="text-muted">Pago seguro con tarjeta o saldo PayPal</small>
                                </button>
                            </form>
                        </div>

                        <!-- PayPhone -->
                        <div class="col-12 col-md-6">
                            <form asp-action="PayPhoneCreate" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="pedidoId" value="@Model.Id" />
                                <button type="submit" class="btn btn-outline-success w-100 p-4 h-100 d-flex flex-column align-items-center justify-content-center" style="min-height: 160px;">
                                    <i class="bi bi-phone fs-1 text-success mb-2"></i>
                                    <span class="fw-semibold fs-5">PayPhone</span>
                                    <small class="text-muted">Pago móvil / código QR</small>
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="mt-4 text-center">
                        <a asp-action="Details" asp-controller="Pedidos" asp-route-id="@Model.Id" class="btn btn-link">
                            <i class="bi bi-arrow-left me-1"></i> Volver al pedido
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
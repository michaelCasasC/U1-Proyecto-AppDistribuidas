@model Proyecto.Models.Pedido
@inject Proyecto.Services.IUserSessionService UserSession

@{
    ViewData["Title"] = "Detalle del Pedido";
    var pedidoPagado = Model.Pagos?.Any(p => p.Estado == "COMPLETED" || p.Estado == "APPROVED") ?? false;
    var payPhonePago = Model.Pagos?.FirstOrDefault(p => p.MetodoPago == "PayPhone" && !string.IsNullOrEmpty(p.PayPhonePaymentUrl));
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark mb-0">
            <i class="bi bi-receipt-cutoff text-primary me-2"></i> Pedido #@Model.Id
        </h2>
        <div>
            @if (UserSession.IsAdmin)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm me-2">
                    <i class="bi bi-pencil me-1"></i> Editar
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Información del Pedido -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i> Información</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Estado</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.Activo ? "bg-success" : "bg-secondary") fs-6 px-3 py-2">
                                @(Model.Activo ? "Activo" : "Inactivo")
                            </span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Fecha</dt>
                        <dd class="col-sm-8">@Model.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-4 text-muted">Total</dt>
                        <dd class="col-sm-8 fw-bold text-success fs-5">$@Model.Total.ToString("F2")</dd>

                        <dt class="col-sm-4 text-muted">Cliente</dt>
                        <dd class="col-sm-8">@Model.Usuario?.Nombre (@Model.Usuario?.Email)</dd>

                        <dt class="col-sm-4 text-muted">Creado</dt>
                        <dd class="col-sm-8 text-muted small">@Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>

                    @if (Model.Pagos != null && Model.Pagos.Any())
                    {
                        <hr />
                        <h6><i class="bi bi-credit-card me-1"></i> Pagos</h6>
                        @foreach (var pago in Model.Pagos.OrderByDescending(p => p.FechaCreacion))
                        {
                            var badgeClass = pago.Estado switch
                            {
                                "COMPLETED" or "APPROVED" => "bg-success",
                                "FAILED" or "ERROR" => "bg-danger",
                                "CANCELLED" => "bg-warning text-dark",
                                _ => "bg-secondary"
                            };
                            <div class="d-flex justify-content-between align-items-center p-2 mb-2 bg-light rounded">
                                <div>
                                    <span class="badge @badgeClass">@pago.Estado</span>
                                    <span class="text-muted ms-2">$@pago.Monto.ToString("F2") @pago.Moneda</span>
                                    <span class="text-muted ms-2">(@pago.MetodoPago)</span>
                                </div>
                                <small class="text-muted">@pago.FechaCreacion.ToLocalTime().ToString("dd/MM HH:mm")</small>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Detalles del Pedido -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i> Detalles del Pedido</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Producto</th>
                                    <th class="text-center" style="width: 120px;">Precio</th>
                                    <th class="text-center" style="width: 100px;">Cantidad</th>
                                    <th class="text-end" style="width: 120px;">Subtotal</th>
                                    <th class="text-center" style="width: 80px;">Stock</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Detalles)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="d-flex flex-column">
                                                <span class="fw-semibold text-dark">@item.Producto?.Nombre</span>
                                                @if (item.Producto != null)
                                                {
                                                    <div class="mt-1">
                                                        <span class="badge bg-secondary-subtle text-secondary me-1">@item.Producto.Categoria?.Nombre</span>
                                                        <span class="badge bg-primary-subtle text-primary">@item.Producto.Emprendimiento?.Nombre</span>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center fw-medium">$@item.PrecioUnitario.ToString("F2")</td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border">@item.Cantidad</span>
                                        </td>
                                        <td class="text-end fw-bold text-dark pe-3">$@item.Total.ToString("F2")</td>
                                        <td class="text-center">
                                            @if (item.Producto != null)
                                            {
                                                var stockBadge = item.Producto.Stock > 5 ? "bg-success" : 
                                                                item.Producto.Stock > 0 ? "bg-warning text-dark" : "bg-danger";
                                                <span class="badge @stockBadge">@item.Producto.Stock</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-end align-items-center">
                        <span class="text-muted me-3">Total:</span>
                        <span class="fs-4 fw-bold text-success">$@Model.Total.ToString("F2")</span>
                    </div>
                </div>
            </div>

            @if (!pedidoPagado && Model.Activo)
            {
                <div class="card shadow-sm border-0 mt-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="bi bi-credit-card me-2"></i> Seleccionar Método de Pago</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted mb-4">Tu pedido está pendiente de pago. Elige cómo quieres pagar:</p>
                        
                        <div class="row g-3">
                            <!-- PayPal -->
                            <div class="col-12 col-md-6">
                                <form asp-controller="Payment" asp-action="PayPalCreate" method="post" asp-route-pedidoId="@Model.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-primary w-100 p-4 h-100 d-flex flex-column align-items-center justify-content-center" style="min-height: 160px;">
                                        <i class="bi bi-paypal fs-1 text-primary mb-2"></i>
                                        <span class="fw-semibold fs-5">PayPal</span>
                                        <small class="text-muted">Tarjeta o saldo PayPal</small>
                                    </button>
                                </form>
                            </div>

                            <!-- PayPhone -->
                            <div class="col-12 col-md-6">
                                <form asp-controller="Payment" asp-action="PayPhoneCreate" method="post" asp-route-pedidoId="@Model.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-success w-100 p-4 h-100 d-flex flex-column align-items-center justify-content-center" style="min-height: 160px;">
                                        <i class="bi bi-phone fs-1 text-success mb-2"></i>
                                        <span class="fw-semibold fs-5">PayPhone</span>
                                        <small class="text-muted">Pago móvil / QR</small>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                @if (payPhonePago != null)
                {
                    <div class="card shadow-sm border-0 mt-4 border-success">
                        <div class="card-header bg-light">
                            <h5 class="mb-0"><i class="bi bi-phone text-success me-2"></i> Enlace de Pago PayPhone</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">Se generó un enlace de pago PayPhone. Haz clic en el botón para abrirlo en una nueva pestaña:</p>
                            <a href="@payPhonePago.PayPhonePaymentUrl" target="_blank" class="btn btn-success btn-lg w-100 py-3 d-flex justify-content-center align-items-center">
                                <i class="bi bi-box-arrow-up-right me-2"></i> Abrir Link de Pago PayPhone
                            </a>
                            <small class="text-muted d-block mt-2 text-center">
                                ID Transacción: @payPhonePago.PayPhoneTransactionId
                            </small>
                        </div>
                    </div>
                }
            }
            else if (pedidoPagado)
            {
                <div class="alert alert-success mt-4 d-flex align-items-center" role="alert">
                    <i class="bi bi-check-circle-fill fs-4 me-3"></i>
                    <div>
                        <strong>¡Pago completado!</strong> Tu pedido ha sido confirmado y está siendo procesado.
                    </div>
                </div>
            }
        </div>
    </div>
</div>